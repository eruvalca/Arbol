<Project>
  <PropertyGroup>
    <_ArbolBuildProject>$(MSBuildThisFileDirectory)Arbol.Build/Arbol.Build.csproj</_ArbolBuildProject>
    <_ArbolDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_ArbolDotNetHost>
    <_ArbolDotNetHost Condition="'$(_ArbolDotNetHost)' == ''">dotnet</_ArbolDotNetHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(_ArbolBuildProject)"
                      ReferenceOutputAssembly="false"
                      OutputItemType="_ArbolBuildAssembly"
                      Private="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>

  <!-- Always recheck, including incremental builds and deleted companion files. -->
  <Target Name="ValidateRazorCodeBehind"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences;ResolveRazorComponentInputs"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ArbolComponentManifest>$(IntermediateOutputPath)arbol-razor-components.txt</_ArbolComponentManifest>
      <_ArbolCompileManifest>$(IntermediateOutputPath)arbol-compile-files.txt</_ArbolCompileManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(_ArbolComponentManifest)" Lines="@(RazorComponent->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_ArbolCompileManifest)" Lines="@(Compile->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <FileWrites Include="$(_ArbolComponentManifest);$(_ArbolCompileManifest)" />
    </ItemGroup>
    <!-- A separate process avoids locking the validator's assemblies in reusable MSBuild nodes. -->
    <Exec Command="&quot;$(_ArbolDotNetHost)&quot; &quot;@(_ArbolBuildAssembly)&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(RootNamespace)&quot; &quot;$(DefineConstants)&quot; &quot;$(_ArbolComponentManifest)&quot; &quot;$(_ArbolCompileManifest)&quot;"
          Condition="'@(RazorComponent)' != ''" />
  </Target>
</Project>
