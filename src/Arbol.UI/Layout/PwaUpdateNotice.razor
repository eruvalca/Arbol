<section id="pwa-update" class="notice" data-kind="information" aria-label="Application update" hidden>
    <p role="status" data-pwa-update-message>A new version of Arbol is ready. Save your work before reloading.</p>
    <div class="pwa-update-actions">
        <button type="button" class="button-primary" data-pwa-reload>Reload to update</button>
        <button type="button" class="button-subtle" data-pwa-later>Later</button>
    </div>
</section>
